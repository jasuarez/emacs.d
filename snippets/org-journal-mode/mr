# -*- mode: snippet -*-
# name: Project merge/pull request
# key: mr
# type: command
# --
;; TAB / S-TAB cycle through the projects, keeping the typed input.
(let ((projects '(("Mesa" . "https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/")
                  ("Piglit" . "https://gitlab.freedesktop.org/mesa/piglit/-/merge_requests/")))
      (index 0)
      (input "")
      (step nil)
      (mr nil)
      (map (make-sparse-keymap)))
  (set-keymap-parent map minibuffer-local-map)
  (define-key map (kbd "TAB") (lambda () (interactive) (setq step 1) (exit-minibuffer)))
  (define-key map (kbd "<backtab>") (lambda () (interactive) (setq step -1) (exit-minibuffer)))
  (while (not mr)
    (setq step nil)
    (setq input (read-from-minibuffer
                 (format "%s MR:" (car (nth index projects))) input map))
    (if step
        (setq index (mod (+ index step) (length projects)))
      (setq mr input)))
  (org-cliplink-gh (concat (cdr (nth index projects)) mr)))
